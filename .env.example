# Base PostgreSQL locale / conteneur
POSTGRES_DB=mojo_erp
POSTGRES_USER=mojo_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# Variables utilisées par l’application Next.js et par les scripts de migration.
PGHOST=localhost
PGPORT=5432
PGDATABASE=mojo_erp
PGUSER=mojo_app
PGPASSWORD=CHANGE_ME_APP_DB_PASSWORD
APP_BASE_URL=http://localhost:3000
FINANCE_DOCUMENTS_DIR=

# Encrypted database backups: use a mounted off-host directory and a private
# 32-byte key (64 hex characters). Keep the key outside this file and repository.
MOJO_BACKUP_OFFSITE_HOST_PATH=
MOJO_BACKUP_ENCRYPTION_KEY=
MOJO_RESTORE_TEST_DATABASE=

# Lot 5 scheduled reminders (configure a private token of at least 32 characters)
MOJO_SCHEDULED_TASK_TOKEN=
MOJO_SCHEDULED_REMINDER_WINDOW_DAYS=7

# Optional browser push (generate VAPID keys; never commit the private key)
MOJO_WEB_PUSH_PUBLIC_KEY=
MOJO_WEB_PUSH_PRIVATE_KEY=
MOJO_WEB_PUSH_SUBJECT=

# Optional Google Calendar integration for automatic meeting and Google Meet creation.
# Store OAuth client credentials and refresh token only in the local, ignored .env file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Self-hosted Jitsi video rooms embedded in Communication.
# Enable JWT authentication on this Jitsi deployment and use the matching app ID/secret.
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
